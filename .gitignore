.gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# IDE
.vscode/
.idea/
.vercel/
*.swp
*.swo
*~
.DS_Store

# Database
instance/
*.db
*.sqlite
*.sqlite3

# Uploads
app/static/uploads/avatars/*
app/static/uploads/videos/*
app/static/uploads/logos/*
!app/static/uploads/avatars/.gitkeep
!app/static/uploads/videos/.gitkeep
!app/static/uploads/logos/.gitkeep

# Environment variables
.env
.env.local
.env.*.local

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp
